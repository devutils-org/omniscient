.TH OMN 1 "2026-10" "Omniscient" "User Commands"
.SH NAME
omn \- one vocabulary for system observability
.SH SYNOPSIS
.B omn
.I source
.RI [ options ]
.RI [ target ]
.RI [ "\-\- program [args]" ]
.br
.B omn
.I family
.RB [ \-\-cost
.IR band ]
.RI [ target ]
.RI [ "\-\- program [args]" ]
.br
.B omn
.B \-f
.I session
.RI [ options ]
.br
.B omn list
.RI [ family | source ]
.br
.B omn validate
.B \-f
.I session
.br
.B omn formats
.br
.B omn latency
.B \-\-objective
.I objective
.RI [ "\-\-runs N" ]
.RB [ \-\-pid
.IR pid " | " "\-\- program [args]" ]
.br
.B omn saturate
.B \-\-objective
.I objective
.RB [ \-\-pid
.IR pid " | " "\-\- program [args]" ]
.br
.B omn diff
.I before after
.br
.B omn join
.B \-f
.I rules results
.br
.B omn import
.I trace results
.RB [ \-o
.IR file ]
.br
.B omn top
.RB [ \-\-view
.IR name ]
.RB [ \-\-pid
.IR pid " | " "\-\- program [args]" ]
.br
.B omn top \-\-replay
.I run
